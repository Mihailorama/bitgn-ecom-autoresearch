  1991	def _try_inventory_count(vm: EcomRuntimeClientSync, task_text: str) -> "ReportTaskCompletion | None":
  1992	    parsed = _parse_inventory_count_request(task_text)
  1993	    if not parsed:
  1994	        return None
  1995	    op, threshold, store_phrase, list_text = parsed
  1996	    store = _find_store(vm, store_phrase)
  1997	    specs = _extract_product_specs(list_text)
  1998	    if not store or not specs:
  1999	        return None
  2000	    if op == "ge":
  2001	        candidate_groups = []
  2002	        for spec in specs:
  2003	            group = _resolve_product_variant(vm, spec)
  2004	            if group["status"] == "unresolved":
  2005	                return None
  2006	            candidate_groups.append(group)
  2007	        query_skus = []
  2008	        seen_query_skus = set()
  2009	        for group in candidate_groups:
  2010	            for p in group["candidates"]:
  2011	                sku = p.get("sku", "")
  2012	                if sku and sku not in seen_query_skus:
  2013	                    seen_query_skus.add(sku)
  2014	                    query_skus.append(sku)
  2015	        if not query_skus:
  2016	            return None
  2017	        skus = ",".join(_sql_quote(sku) for sku in query_skus)
  2018	        q = f"""
  2019	SELECT sku, available_today
  2020	FROM inventory
  2021	WHERE store_id={_sql_quote(store['id'])}
  2022	  AND sku IN ({skus});
  2023	"""
  2024	        rows = _csv_dicts(_exec_sql_stdout(vm, q))
  2025	        avail_by_sku = {r.get("sku", ""): int(r.get("available_today") or 0) for r in rows}
  2026	        _emit_inventory_diagnostics(store, specs, candidate_groups, avail_by_sku, threshold, op)
  2027	        inventory_result = _build_inventory_refs(store, candidate_groups, avail_by_sku, threshold, op)
  2028	        return ReportTaskCompletion(
  2029	            tool="report_completion",
  2030	            completed_steps_laconic=["deterministic store inventory count via exact candidate SQL"],
  2031	            message=_format_numeric_for_task(task_text, inventory_result["count"]),
  2032	            grounding_refs=inventory_result["refs"],
  2033	            outcome="OUTCOME_OK",
  2034	            verified=True,
  2035	        )
  2036	    products = []
  2037	    for spec in specs:
  2038	        product = _select_product(vm, spec, strict_props=True)
  2039	        if product is None:
  2040	            product = _select_product(vm, spec, strict_props=False)
  2041	        if product is None:
  2042	            return None
  2043	        products.append(product)
  2044	    uniq_products = []
  2045	    seen_skus = set()
  2046	    for p in products:
  2047	        sku = p.get("sku", "")
  2048	        if not sku or sku in seen_skus:
