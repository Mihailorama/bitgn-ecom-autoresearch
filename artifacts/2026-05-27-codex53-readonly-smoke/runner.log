  2050	        seen_skus.add(sku)
  2051	        uniq_products.append(p)
  2052	    if not uniq_products:
  2053	        return None
  2054	    skus = ",".join(_sql_quote(p["sku"]) for p in uniq_products)
  2055	    q = f"""
  2056	SELECT sku, available_today
  2057	FROM inventory
  2058	WHERE store_id={_sql_quote(store['id'])}
  2059	  AND sku IN ({skus});
  2060	"""
  2061	    rows = _csv_dicts(_exec_sql_stdout(vm, q))
  2062	    avail_by_sku = {r.get("sku", ""): int(r.get("available_today") or 0) for r in rows}
  2063	    if op == "ge":
  2064	        qualifying = [p for p in uniq_products if avail_by_sku.get(p["sku"], 0) >= threshold]
  2065	        ref_products = qualifying
  2066	    else:
  2067	        qualifying = [p for p in uniq_products if avail_by_sku.get(p["sku"], 0) < threshold]
  2068	        ref_products = [p for p in qualifying if avail_by_sku.get(p["sku"], 0) > 0]
  2069	    n = len(qualifying)
  2070	    refs = [store["path"]] + [p["path"] for p in ref_products]
  2071	    return ReportTaskCompletion(
  2072	        tool="report_completion",
  2073	        completed_steps_laconic=["deterministic store inventory count via SQL"],
  2074	        message=_format_numeric_for_task(task_text, n),
  2075	        grounding_refs=refs,

