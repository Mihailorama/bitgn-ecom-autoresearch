# Copy to .env (gitignored) and fill in only for live BitGN runs.

BITGN_API_KEY=
MODEL_ID=codex:gpt-5.3-codex
BENCHMARK_ID=bitgn/ecom1-dev
BITGN_HOST=https://api.bitgn.com
PARALLEL=6
SWEEP_LOG_DIR=runs/evaluator

# Override when testing a different candidate entrypoint.
AGENT_CMD=uv run python agent.py --submit --json
